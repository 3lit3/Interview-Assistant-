# Copy to .env for local testing (or set these as Render environment variables).

# Required: a SEPARATE token from the one in the Interview Assistant folder's .env.
# Telegram cannot use a webhook and getUpdates polling on the same bot token.
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Recommended: any random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(24))"
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-string

# Optional on Render (RENDER_EXTERNAL_URL is detected automatically).
# PUBLIC_URL=https://your-bot.onrender.com

# Optional: direct HTTPS link to the ZIP. If empty, a .zip placed in
# telegram_bot/downloads/ is served at /download instead.
DOWNLOAD_URL=https://your-static-site.onrender.com/Interview-Assistant.zip

# Optional: exact path to a ZIP file instead of auto-detecting downloads/*.zip.
# DOWNLOAD_FILE=/absolute/path/to/Interview-Assistant.zip

LOG_LEVEL=INFO
