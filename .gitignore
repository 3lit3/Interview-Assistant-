# Default: ignore everything at the repo root (there are unrelated sibling projects here)
/*

# Keep only the Interview Assistant project folders and root docs
!/Interview Assistant/
!/Interview Assistant - whispercpp/
!/README.md
!/.gitignore
!/LICENSE

# Secrets
**/.env

# Python caches
**/__pycache__/
**/*.pyc

# Virtual environments
**/win_env/
**/ass_env/
**/.venv/
**/venv/

# Downloaded STT model weights / large binaries
**/*.bin
**/models/

# Personal CV / resume files (avoid committing PII; supply at runtime via --cv or Telegram)
**/*.pdf

# Build artifacts
**/build/
**/dist/
**/*.egg-info/
