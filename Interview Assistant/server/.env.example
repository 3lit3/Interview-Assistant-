# ── Interview Assistant license server ────────────────────────────────────────
# Copy to server\.env and fill in. Render uses its own dashboard env — keep the
# two in sync (same names).

# Product
PRICE_USD=14.99
PERIOD_DAYS=30
DEVICE_CAP=2

# Public base URL of THIS server (used in the payment success link):
#   local dev:  http://127.0.0.1:8000
#   production: https://interview-assistant-okvy.onrender.com
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Ed25519 signing key for license keys (base64url raw 32-byte seed).
# Generate with:  python server/mint_key.py --genkey
# NEVER commit the real value; NEVER put it in the client.
SIGNING_PRIVATE_KEY=

# NowPayments (https://nowpayments.io) — API key + IPN secret.
# Leave empty and MOCK_NOWPAYMENTS=1 for local testing (mock-pay endpoint).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Public IPN webhook (Render URL): https://interview-assistant-okvy.onrender.com/ipn
IPN_CALLBACK_URL=
# 1 = mock payments (dev), 0 = live NowPayments
MOCK_NOWPAYMENTS=1

# Postgres connection string (Supabase/Render). Empty = local SQLite file
# (server/licensing.db) for development.
DATABASE_URL=

# Admin token for /admin/* endpoints (mint comps, revoke, lookup).
ADMIN_TOKEN=

# Telegram bot that delivers purchased keys to the paying chat
# (long-polls getUpdates; /start buy_<order>, /mykeys).
# Copy from config/api_keys.json -> telegram_bot_token for local testing.
# Empty = chat delivery disabled. Prefer a dedicated product bot at launch
# (the app's own Telegram panel also polls getUpdates -> 409 conflicts).
TELEGRAM_BOT_TOKEN=
